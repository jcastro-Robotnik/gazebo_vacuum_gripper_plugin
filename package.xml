<?xml version="1.0"?>
<package format="3">
  <name>vacuum_gripper_plugin</name>
  <version>0.0.1</version>
  <description>Vacuum gripper plugin for Gazebo Sim + ROS 2 bridge</description>

  <maintainer email="jcastro@robotnik.es">jorge</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-cmake3</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-common5</depend>
  <depend>gz-math7</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-sim8</depend>
  <depend>gz-transport13</depend>
  <depend>sdformat14</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
